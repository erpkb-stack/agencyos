# AgencyOS configuration. Copy to .env and fill in. Never commit .env.

# development | test | production
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Required in production (>= 32 random characters). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development, a random key is generated per start (sessions reset on restart).
SECRET_KEY=replace-with-a-long-random-string

SESSION_TTL_HOURS=12
# Leave empty to use defaults (Secure cookies only in production).
# COOKIE_SECURE=true
# Comma-separated origins allowed for cross-origin API access. Empty = same-origin only.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300

# Development-only one-click login. Ignored unless APP_ENV=development;
# the app refuses to start if this is true with APP_ENV=production.
ENABLE_DEMO_LOGIN=false

# SQLite by default (relative to the project root when unset). PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://agencyos:password@localhost:5432/agencyos
# DATABASE_URL=sqlite:////absolute/path/to/agencyos.db
DATABASE_ECHO=false

# LLM provider: mock (offline, default) | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Anthropic effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Retry a safety-declined request on Anthropic's fallback model (server-side, same call)
ANTHROPIC_REFUSAL_FALLBACK=true
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=16000
LLM_MAX_RETRIES=2

# Agency identity for email drafts (required in every marketing email: sender + postal address).
# Leave empty until known; previews then show [missing: ...] instead of invented values.
# Put values containing # in double quotes: an unquoted " #" starts a comment.
# AGENCY_NAME=Your Agency LLC
# AGENCY_ADDRESS=123 Main St, Austin, TX 78701
# SENDER_NAME=Your Name
# SENDER_EMAIL=you@youragency.com
# Base URL used to build unsubscribe links
# PUBLIC_BASE_URL=http://localhost:8000

# --- Production hardening (defaults shown) ---
# ENABLE_API_DOCS=false            # /docs is off in production unless set to true
# MAX_REQUEST_BYTES=5242880        # larger request bodies are rejected (413)
# LOGIN_ACCOUNT_LIMIT=5            # failed logins per account …
# LOGIN_ACCOUNT_WINDOW_SECONDS=900 # … within this window before the account is throttled
# FORWARDED_ALLOW_IPS=127.0.0.1    # Docker: your reverse proxy's address
# PostgreSQL (docker compose --profile postgres):
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://agencyos:<password>@db:5432/agencyos

# --- Agent execution (Phase 7) ---
# ORCHESTRATOR_PARALLEL_AGENTS=3   # specialists of one request running at once
# TASK_WORKERS=2                   # requests processed at once
# RUN_WORKER_IN_PROCESS=true       # false + `python -m app.cli worker` for a separate worker
# AI_COST_LIMIT_PER_REQUEST=2.00   # estimated USD per request (0 = no limit)
# AI_COST_LIMIT_PER_MONTH=0        # estimated USD per calendar month (0 = no limit)

# --- Email sending (Phase 10) ---
# Off by default. Only campaigns a Founder/Admin approved, and that you then start, are sent.
# Use a provider that allows bulk/marketing email (Amazon SES, Postmark, Brevo, SendGrid,
# Google Workspace / Microsoft 365 within their limits). Personal mailboxes are not suitable.
# EMAIL_TRANSPORT=disabled         # smtp to send
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls           # starttls (587) | ssl (465) | none (local test servers only)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_DAILY_LIMIT=50             # emails per rolling 24 hours
# EMAIL_SEND_INTERVAL_SECONDS=20   # pause between emails
# EMAIL_MAX_RECIPIENTS=500         # per campaign
# EMAIL_REDIRECT_TO=               # test mode: send everything to this address instead

# --- Two-factor authentication (Phase 9) ---
# REQUIRE_2FA_FOR_ADMINS=false     # true: Founders/Admins must enrol an authenticator app

# --- Prospect website research (Phase 8) ---
# WEB_RESEARCH_ENABLED=true
# WEB_RESEARCH_MAX_PAGES=3
# WEB_RESEARCH_TIMEOUT_SECONDS=10
# WEB_RESEARCH_CONCURRENCY=3
# WEB_RESEARCH_BULK_LIMIT=50
