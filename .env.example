# AgencyOS configuration. Copy to .env and fill in. Never commit .env.

# development | test | production
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Required in production (>= 32 random characters). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development, a random key is generated per start (sessions reset on restart).
SECRET_KEY=replace-with-a-long-random-string

SESSION_TTL_HOURS=12
# Leave empty to use defaults (Secure cookies only in production).
# COOKIE_SECURE=true
# Comma-separated origins allowed for cross-origin API access. Empty = same-origin only.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300

# Development-only one-click login. Ignored unless APP_ENV=development;
# the app refuses to start if this is true with APP_ENV=production.
ENABLE_DEMO_LOGIN=false

# SQLite by default (relative to the project root when unset). PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://agencyos:password@localhost:5432/agencyos
# DATABASE_URL=sqlite:////absolute/path/to/agencyos.db
DATABASE_ECHO=false

# LLM provider: mock (offline, default) | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Anthropic effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Retry a safety-declined request on Anthropic's fallback model (server-side, same call)
ANTHROPIC_REFUSAL_FALLBACK=true
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=16000
LLM_MAX_RETRIES=2
